# Variáveis da infraestrutura central de desenvolvimento.
# Copie para .env (cp .env.example .env). Os valores abaixo são só para desenvolvimento local;
# troque todos em qualquer outro ambiente. O arquivo .env nunca vai para o repositório.

COMPOSE_PROJECT_NAME=plataforma-iot

# PostgreSQL com TimescaleDB e PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=iot
POSTGRES_PASSWORD=troque-esta-senha-pg
POSTGRES_DB=iot

# Redis (último estado, deduplicação e barramento interno)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=troque-esta-senha-redis

# Mosquitto (listener 1883 sem TLS; TLS e ACL na trilha T3)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_DEV_USERNAME=dev
MQTT_DEV_PASSWORD=troque-esta-senha-mqtt

# Keycloak (modo de desenvolvimento, realm iot importado de infra/keycloak/realm.json)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha-keycloak
KEYCLOAK_CORE_API_CLIENT_SECRET=troque-este-segredo-core-api
PANEL_URL=http://localhost:3000

# Mailpit (SMTP de desenvolvimento)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# core-api: porta HTTP e nível de log
CORE_API_PORT=3001
LOG_LEVEL=info
# Ingestão MQTT (ADR-017): conexões em assinatura compartilhada, espera entre reconexões após
# falha e janela da gravação em grupo das medições
MQTT_INGEST_CONNECTIONS=32
MQTT_INGEST_CLIENT_ID=core-api-ingestao
MQTT_INGEST_SHARE_GROUP=core-api
MQTT_INGEST_RETRY_MS=2000
INGEST_WRITE_BATCH_ROWS=2000
INGEST_WRITE_BATCH_WAIT_MS=5
# Varredura de estado dos dispositivos (RF-DIS-06), em milissegundos
DEVICE_STATUS_SWEEP_MS=30000
# Credencial do dispositivo de desenvolvimento usada pelo basic-publisher; o pnpm seed:dev grava aqui
SIM_DEVICE_TOKEN=

# Testcontainers (testes de integração). Em hosts com SELinux em modo Enforcing (Fedora, RHEL),
# o Ryuk só acessa o docker.sock em modo privilegiado; descomente a linha abaixo nesses hosts.
# O CI não define esta variável.
# TESTCONTAINERS_RYUK_PRIVILEGED=true
