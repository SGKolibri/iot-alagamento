    "@nestjs/platform-express": "11.2.7",
    "ioredis": "6.0.0",
    "mqtt": "5.16.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@iot/simulators": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
