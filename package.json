{
  "name": "plataforma-iot",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma IoT Integrada: núcleo neutro, contrato canônico e nó de borda",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:cov": "pnpm -r --workspace-concurrency=1 run test:cov",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "contracts:validate": "pnpm --filter @iot/contracts run validate",
    "test:infra": "tsx scripts/test-infra.ts",
    "test:mutation": "pnpm --filter @iot/domain run test:mutation"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "mqtt": "5.16.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
